{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TabBorrowResult",
  "type": "object",
  "required": [
    "agent_window_id",
    "original_index",
    "original_window_id",
    "tab_id"
  ],
  "properties": {
    "agent_window_id": {
      "type": "integer",
      "format": "int64"
    },
    "in_place": {
      "description": "True when the tab was attached in place rather than moved into the Agent Window; `original_window_id`/`original_index` then describe the tab's own (unchanged) location. Absent on legacy moves so older CLI peers parse the result unchanged.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "original_index": {
      "type": "integer",
      "format": "int32"
    },
    "original_window_id": {
      "type": "integer",
      "format": "int64"
    },
    "tab_id": {
      "type": "integer",
      "format": "int64"
    }
  }
}
